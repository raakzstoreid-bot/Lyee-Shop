
Nama: .github/workflows/auto.yml

name: Auto Extract ZIP

on:
  push:
    branches:
      - main # Ubah menjadi 'master' jika repository Anda menggunakan branch master

jobs:
  extract:
    runs-on: ubuntu-latest
    permissions:
      contents: write 

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Ekstrak dan Hapus ZIP
        run: |
          shopt -s nullglob
          ZIP_FILES=(*.zip)
          
          if [ ${#ZIP_FILES[@]} -eq 0 ]; then
            echo "Tidak ada file .zip di root direktori. Melewati proses."
            exit 0
          fi

          for zip_file in "${ZIP_FILES[@]}"; do
            echo "Mengekstrak: $zip_file"
            unzip -o "$zip_file" -d .
            rm "$zip_file"
          done

      - name: Commit dan Push Hasil Ekstraksi
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add .
          
          if git diff-index --quiet HEAD; then
            echo "Tidak ada file baru yang perlu di-commit."
          else
            git commit -m "chore: Auto-extract ZIP file(s) [skip ci]"
            git push
          fi
